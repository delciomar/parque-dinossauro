<%- include('../cabecalho')%>

    <div>
        <tr><a href="/dinossauro"> ← Voltar </a></tr>
        <h3>Alterar Dinossauro</h3>

        <form method="post">
            <p>ID</p>
            <input type="text" name="id" value="<%=dinossauro.id%>" readonly>
            <p>Nome</p>
            <input type="text" name="nome" value="<%=dinossauro.nome%>">
            <p>Espécie</p>
            <select name="especie">
                <option value="">Selecione...</option>
                <option value="Theropoda">Theropoda</option>
                <option value="Sauropoda">Sauropoda</option>
                <option value="Ceratopsia">Ceratopsia</option>
                <option value="Ornithopoda">Ornithopoda</option>
            </select>
            <br>

            <p>Descrição</p>
            <textarea type="text" name="descricao" value="<%=dinossauro.descricao%>"></textarea>
            <br>

            <p>Altura (metros)</p>
            <input name="altura" type="number" value="<%=dinossauro.altura%>">
            <p>Peso (toneladas)</p>
            <input name="peso" type="number" value="<%=dinossauro.peso%>">
            <p>Ano de Descoberta</p>
            <input name="anoDescoberta" type="number" value="<%=dinossauro.anoDescoberta%>">
            <br>

            <p>Dieta</p>
            <select name="dieta">
                <option value="">Selecione...</option>
                <option value="Carnívoro">Carnívoro</option>
                <option value="Herbívoro">Herbívoro</option>
                <option value="Onívoro">Onívoro</option>
            </select>
            <br><br>

            <button type="submit">Salvar</button>
            <button type="reset">Cancelar</button>

        </form>

    </div>
    </body>

    </html>